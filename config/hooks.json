[
    {
        "id": "metrics",
        "execute-command": "/opt/webhook/scripts/metrics.sh",
        "command-working-directory": "/opt/webhook/data",
        "trigger-rule": {
            "match": {
                "type": "value",
                "value": "{{ getenv `WEBHOOK_API_TOKEN` }}",
                "parameter": {
                    "source": "header",
                    "name": "X-api-key"
                }
            }
        },
        "pass-arguments-to-command": [
            {
                "source": "entire-payload"
            }
        ],
        "include-command-output-in-response": true
    },
    {
        "id": "whoami",
        "execute-command": "/opt/webhook/scripts/whoami.sh",
        "command-working-directory": "/opt/webhook/data",
        "trigger-rule": {
            "match": {
                "type": "value",
                "value": "{{ getenv `WEBHOOK_API_TOKEN` }}",
                "parameter": {
                    "source": "header",
                    "name": "X-api-key"
                }
            }
        },
        "pass-arguments-to-command": [
            {
                "source": "request",
                "name": "remote-addr"
            },
            {
                "source": "payload",
                "name": "expected_ip"
            }
        ],
        "include-command-output-in-response": true
    },
    {
        "id": "8ball",
        "execute-command": "/opt/webhook/scripts/8ball.sh",
        "command-working-directory": "/opt/webhook/data",
        "trigger-rule": {
            "match": {
                "type": "value",
                "value": "{{ getenv `WEBHOOK_API_TOKEN` }}",
                "parameter": {
                    "source": "header",
                    "name": "X-api-key"
                }
            }
        },
        "pass-arguments-to-command": [
            {
                "source": "payload",
                "name": "question"
            }
        ],
        "include-command-output-in-response": true
    }
]