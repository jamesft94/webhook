[Unit]
Description=Adnanh Webhook Service
After=network.target

[Service]
Type=simple
User=webhook
Group=webhook
WorkingDirectory=/opt/webhook
EnvironmentFile=/opt/webhook/.env
ExecStart=/usr/bin/webhook -hooks /opt/webhook/config/hooks.json -port 9000 -verbose -hotreload -template
Restart=on-failure
RestartSec=5s

# Restrict writes strictly to /opt/webhook
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/webhook/data

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
